<?xml version="1.0" ?>
<project name="JsPlus-Core" default="build" basedir=".">
	<property environment="env" />
	<property name="jr.charset" value="UTF-8" />
	<property name="jr.root" location="./" />
	<property name="jr.src" value="${jr.root}/src" />
	<property name="jr.lib" value="${jr.root}/LibHome/" />
	<property name="jr.build" value="${jr.root}/build/" />
	<property name="jr.classes" value="${jr.build}/classes" />
	<property name="jr.versionfile" value="${jr.src}/com/killcoding/jsplus/ConsoleImpl.java" />

	<!-- version.properties keeps the build version across builds
	     (automatic memory: patch is incremented by 1 on every ant build).
	     The three keys are created once on the first build, then jr.patch
	     is bumped; jr.major / jr.minor are only changed by hand. -->
	<condition property="jr.version.file.exists">
		<available file="${jr.root}/version.properties" />
	</condition>

	<path id="classpath">
		<fileset dir="${jr.lib}">
			<include name="**/*.jar" />
		</fileset>
	</path>

	<target name="version-init" unless="jr.version.file.exists">
		<mkdir dir="${jr.build}" />
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.major" type="int" default="0" />
			<entry key="jr.minor" type="int" default="0" />
			<entry key="jr.patch" type="int" default="0" />
		</propertyfile>
	</target>

	<!-- Standard semver: jr.version = major.minor.patch, patch +1 every build.
	     Each segment is capped at 999; 999 + 1 carries into the next higher
	     segment (0.0.999 + 1 -> 0.1.0, 0.9.999 + 1 -> 1.0.0). NOTE: ant's
	     propertyfile formats ints with the locale (1000 -> "1,000"), which
	     would corrupt the file, so we never write a value of 1000: we check
	     for 999 first and carry directly. ant 1.9's propertyfile task has no
	     "if" attribute, so the bump is split into mutually exclusive targets
	     using target-level if/unless. -->
	<!-- NOTE: ant properties are immutable once set, so this target loads
	     the PRE-bump values under the jr.old.* names only (they drive the
	     bump arithmetic and the 999 carry checks). version-final is the
	     single place that loads the file WITHOUT a prefix, i.e. the real
	     post-bump values, so ${jr.version} (changelog header + jar name)
	     always matches version.properties. -->
	<target name="version-flags" depends="version-init">
		<loadproperties srcFile="${jr.root}/version.properties" prefix="jr.old." />
		<condition property="jr.patch.max">
			<matches string="${jr.old.jr.patch}" pattern="999" />
		</condition>
		<condition property="jr.minor.max">
			<matches string="${jr.old.jr.minor}" pattern="999" />
		</condition>
		<condition property="jr.carry.major">
			<and>
				<matches string="${jr.old.jr.patch}" pattern="999" />
				<matches string="${jr.old.jr.minor}" pattern="999" />
			</and>
		</condition>
	</target>

	<!-- case A: patch < 999 -> patch +1 -->
	<target name="bump-case-a" depends="version-flags" unless="jr.patch.max">
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.patch" type="int" default="${jr.old.jr.patch}" operation="+" />
		</propertyfile>
	</target>

	<!-- case B: patch=999 and minor < 999 -> patch=0, minor+1 -->
	<target name="bump-case-b" depends="version-flags" if="jr.patch.max" unless="jr.carry.major">
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.patch" type="int" value="0" />
			<entry key="jr.minor" type="int" default="${jr.old.jr.minor}" operation="+" />
		</propertyfile>
	</target>

	<!-- case C: patch=999 and minor=999 -> patch=0, minor=0, major+1 -->
	<target name="bump-case-c" depends="version-flags" if="jr.carry.major">
		<propertyfile file="${jr.root}/version.properties">
			<entry key="jr.patch" type="int" value="0" />
			<entry key="jr.minor" type="int" value="0" />
			<entry key="jr.major" type="int" default="${jr.old.jr.major}" operation="+" />
		</propertyfile>
	</target>

	<target name="version-final" depends="bump-case-a,bump-case-b,bump-case-c">
		<loadproperties srcFile="${jr.root}/version.properties" />
		<property name="jr.version" value="${jr.major}.${jr.minor}.${jr.patch}" />
		<tstamp>
			<format property="jr.builddate" pattern="yyyy.MM.dd" />
		</tstamp>
		<echo message="Build version bumped to ${jr.version}" />
	</target>

	<target name="version-bump" depends="version-final" />

	<!-- ============================================================
	     changes.log (English) + changes_zh-HK.log (Traditional Chinese) -
	     one history entry per build, written to both files.
	     Header line: ## <version> (<builddate> <buildtime>)
	     English entry priority:
	       1) -Dchange.en="..."            (CI / command line)
	       2) build/changes-pending-en.txt (local note; consumed & removed)
	       3) default "- build: automatic version bump"
	     Traditional Chinese entry priority:
	       1) -Dchange.zh="..."            (CI / command line)
	       2) build/changes-pending-zh-HK.txt (local note; consumed & removed)
	       3) default "- build: 自動版本遞增"
	     Entries are appended with UTF-8 encoding so Chinese descriptions
	     survive on Windows. -->
	<target name="write-changelog" depends="version-bump">
		<tstamp>
			<format property="jr.buildtime" pattern="HH:mm:ss" />
		</tstamp>
		<mkdir dir="${jr.root}/build" />
		<available file="${jr.root}/build/changes-pending-en.txt" property="jr.chg.enPending" />
		<available file="${jr.root}/build/changes-pending-zh-HK.txt" property="jr.chg.zhPending" />
		<!-- default entry only when neither the -D property nor the pending
		     file supplied a description (AND semantics; target-level unless
		     is OR across a comma-separated list) -->
		<condition property="jr.chg.enNeedDefault">
			<and>
				<not>
					<isset property="change.en" />
				</not>
				<not>
					<isset property="jr.chg.enPending" />
				</not>
			</and>
		</condition>
		<condition property="jr.chg.zhNeedDefault">
			<and>
				<not>
					<isset property="change.zh" />
				</not>
				<not>
					<isset property="jr.chg.zhPending" />
				</not>
			</and>
		</condition>
		<concat destfile="${jr.root}/changes.log" append="true" encoding="UTF-8">
			<string>&#10;## ${jr.version} (${jr.builddate} ${jr.buildtime})&#10;</string>
		</concat>
		<concat destfile="${jr.root}/changes_zh-HK.log" append="true" encoding="UTF-8">
			<string>&#10;## ${jr.version} (${jr.builddate} ${jr.buildtime})&#10;</string>
		</concat>
	</target>

	<!-- ============================================================
	     changelog-diff - diff the Java sources of this project against the
	     sibling Githubrepos copy on every build. When any Java file differs
	     (A/M/D), the diff lines are written into both changelogs, each line
	     marked "found diffed" so an agent/user can review and refine the
	     entry later. The sibling root is optional: when it does not exist
	     (e.g. CI checkouts) the diff step is skipped silently. -->
	<property name="jr.diffroot" value="${jr.root}/../../Githubrepos/JsPlus-Core/src" />

	<target name="changelog-diff" depends="write-changelog">
		<available file="${jr.diffroot}" property="jr.diff.root.exists" />
		<antcall target="changelog-diff-run" />
	</target>

	<target name="changelog-diff-run" if="jr.diff.root.exists">
		<mkdir dir="${jr.build}/tools" />
		<mkdir dir="${jr.build}/classes-tools" />
		<javac srcdir="${jr.build}/tools" destdir="${jr.build}/classes-tools"
			encoding="UTF-8" includeantruntime="false" fork="true"
			includejavaruntime="false" />
		<java classname="DiffScanner" classpath="${jr.build}/classes-tools"
			fork="true" failonerror="false">
			<arg value="${jr.src}" />
			<arg value="${jr.diffroot}" />
			<arg value="${jr.build}/.diff-changes.txt" />
		</java>
		<loadfile property="jr.diff.changes" srcFile="${jr.build}/.diff-changes.txt"
			encoding="UTF-8" failonerror="false" />
		<concat destfile="${jr.root}/changes.log" append="true" encoding="UTF-8">
			<string>${jr.diff.changes}</string>
		</concat>
		<concat destfile="${jr.root}/changes_zh-HK.log" append="true" encoding="UTF-8">
			<string>${jr.diff.changes}</string>
		</concat>
	</target>

	<target name="changelog-en-manual" depends="write-changelog" if="change.en">
		<concat destfile="${jr.root}/changes.log" append="true" encoding="UTF-8">
			<string>- ${change.en}&#10;&#10;</string>
		</concat>
	</target>

	<target name="changelog-en-pending" depends="write-changelog" unless="change.en" if="jr.chg.enPending">
		<loadfile property="jr.pending.en" srcFile="${jr.root}/build/changes-pending-en.txt"
			encoding="UTF-8" failonerror="false" />
		<concat destfile="${jr.root}/changes.log" append="true" encoding="UTF-8">
			<string>${jr.pending.en}</string>
		</concat>
		<delete file="${jr.root}/build/changes-pending-en.txt" />
	</target>

	<target name="changelog-en-default" depends="write-changelog" if="jr.chg.enNeedDefault">
		<concat destfile="${jr.root}/changes.log" append="true" encoding="UTF-8">
			<string>- build: automatic version bump&#10;&#10;</string>
		</concat>
	</target>

	<target name="changelog-zh-manual" depends="write-changelog" if="change.zh">
		<concat destfile="${jr.root}/changes_zh-HK.log" append="true" encoding="UTF-8">
			<string>- ${change.zh}&#10;&#10;</string>
		</concat>
	</target>

	<target name="changelog-zh-pending" depends="write-changelog" unless="change.zh" if="jr.chg.zhPending">
		<loadfile property="jr.pending.zh" srcFile="${jr.root}/build/changes-pending-zh-HK.txt"
			encoding="UTF-8" failonerror="false" />
		<concat destfile="${jr.root}/changes_zh-HK.log" append="true" encoding="UTF-8">
			<string>${jr.pending.zh}</string>
		</concat>
		<delete file="${jr.root}/build/changes-pending-zh-HK.txt" />
	</target>

	<target name="changelog-zh-default" depends="write-changelog" if="jr.chg.zhNeedDefault">
		<concat destfile="${jr.root}/changes_zh-HK.log" append="true" encoding="UTF-8">
			<string>- build: 自動版本遞增&#10;&#10;</string>
		</concat>
	</target>

	<!-- Replace the ${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})
	     placeholders in ConsoleImpl.java with the real build values before
	     compilation. The regex first restores the placeholder in case a
	     previous build stopped before restoring it. -->
	<target name="replace-version" depends="version-bump">
		<replaceregexp file="${jr.versionfile}"
			match="[0-9]+\.[0-9]+\.[0-9]+ ?\([0-9]{4}\.[0-9]{2}\.[0-9]{2}\)"
			replace="${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})" byline="true" />
		<replace file="${jr.versionfile}"
			token="${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})"
			value="${jr.version}(${jr.builddate})" />
		<echo message="Replaced version placeholder with ${jr.version}(${jr.builddate}) in ConsoleImpl.java" />
	</target>

    <target name="clear">
		<delete dir="${jr.classes}" />
		<mkdir dir="${jr.classes}" />
	</target>

    <target name="compile" depends="clear,replace-version">
		<javac debug="true"  destdir="${jr.classes}" encoding="${jr.charset}" nowarn="true" includeantruntime="false">
			<src>
				<pathelement location="${jr.src}" />
			</src>
			<classpath refid="classpath" />
			<compilerarg line="-Xlint:-unchecked -Xlint:-deprecation"/>
			<compilerarg value="-Xlint:none"/>
		</javac>
		<copy todir="${jr.classes}">
			<fileset dir="${jr.src}">
				<exclude name="**/*.java" />
			</fileset>
		</copy>

		<!-- Restore the placeholders in ConsoleImpl.java immediately after
		     compilation, so the source always stays in placeholder form even
		     when only the compile target is run. -->
		<replaceregexp file="${jr.versionfile}"
			match="[0-9]+\.[0-9]+\.[0-9]+ ?\([0-9]{4}\.[0-9]{2}\.[0-9]{2}\)"
			replace="${BuildVersion.VERSION}(${BuildVersion.BUILD_DATE})" byline="true" />
		<echo message="Restored version placeholder in ConsoleImpl.java" />
	</target>


	<target name="package" depends="compile,changelog-diff,changelog-en-manual,changelog-en-pending,changelog-en-default,changelog-zh-manual,changelog-zh-pending,changelog-zh-default">
	    <manifestclasspath property="jar.classpath" jarfile="main.jar">
	      <classpath>
	        <fileset dir="${jr.lib}" includes="*.jar"/>
	      </classpath>
	    </manifestclasspath>

		<!-- Remove the previous build's jar so the classpath never contains
		     two jsplus-core jars at once (only our own jar is matched). -->
		<delete>
			<fileset dir="${jr.lib}/jsplus/default">
				<include name="jsplus-core-*.jar" />
			</fileset>
		</delete>

		<jar jarfile="${jr.lib}/jsplus/default/jsplus-core-${jr.version}.jar" >
			<fileset dir="${jr.classes}">
				<include name="com/**/**/*" />
			</fileset>

			<!--<manifest>-->
			<!--    <attribute name="Main-Class"  value="com.killcoding.jsplus.Main"/>-->
			<!--	<attribute name="Class-Path" value="${jar.classpath}"/>-->
			<!--</manifest>-->
		</jar>
		<echo message="Packaged jsplus-core-${jr.version}.jar" />
	</target>
	<target name="build" depends="package,javadoc" />
	<!-- ============================================================
	     javadoc - generate the API site into docs/api after every build.
	     Version-tagged window title; -Xdoclint:none keeps the build green
	     even when a comment is not 100% javadoc-clean. Skip a build with
	     -Djavadoc.skip=true when only the jar is needed.
	     NOTE: ConsoleImpl.java carries a version placeholder that is
	     swapped to the real version only during compile; javadoc reads the
	     source, so the restored placeholder form is used - fine.
	     ============================================================ -->
	<target name="javadoc" depends="version-final" unless="javadoc.skip">
		<delete dir="${jr.root}/docs/api" />
		<mkdir dir="${jr.root}/docs/api" />
		<javadoc destdir="${jr.root}/docs/api"
			sourcepath="${jr.src}"
			classpathref="classpath"
			encoding="${jr.charset}"
			charset="${jr.charset}"
			docencoding="${jr.charset}"
			windowtitle="JsPlus-Core ${jr.version} API"
			use="true"
			linksource="true"
			failonerror="true">
			<arg value="-Xdoclint:none"/>
			<doctitle><![CDATA[<h1>JsPlus-Core ${jr.version}</h1>]]></doctitle>
			<bottom><![CDATA[<i>JsPlus-Core ${jr.version} - KILLCODING.COM - MIT License</i>]]></bottom>
		</javadoc>
		<echo message="Generated javadoc to docs/api (JsPlus-Core ${jr.version})" />
	</target>
</project>
